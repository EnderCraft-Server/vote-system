# 前台站点（PHP-FPM）
server {
    listen 443 ssl http2;
    server_name vote.example.com;

    ssl_certificate     /etc/ssl/vote/fullchain.pem;
    ssl_certificate_key /etc/ssl/vote/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /srv/vote-system/frontend/public;
    index index.php;

    # 只暴露 public/，app/ views/ config/ 不在站点根内
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include        fastcgi_params;
        fastcgi_param  SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass   unix:/run/php/php8.2-fpm.sock;
        fastcgi_read_timeout 15s;
    }

    location ~* \.(png|jpg|svg|css|js|woff2)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
    }

    client_max_body_size 256k;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
}

# 管理后台（Go，独立端口）——建议只在内网或 VPN 暴露
server {
    listen 8443 ssl;
    server_name admin.vote.example.com;

    ssl_certificate     /etc/ssl/vote/fullchain.pem;
    ssl_certificate_key /etc/ssl/vote/privkey.pem;

    # 双重保险：即使公网可达，也只放行办公网段
    allow 10.0.0.0/8;
    allow 127.0.0.1;
    deny  all;

    location / {
        proxy_pass http://127.0.0.1:7789;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
